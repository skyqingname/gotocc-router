# GoToCC build image: the operations workflow runs tools/gotocc_build.py in it.
# Keep NODE_VERSION equal to node_version in gotocc-build.json, which CI uses.
# Do not reuse this as an application runtime.
FROM debian:bookworm-slim

ARG GO_VERSION=1.27.3
ARG NODE_VERSION=20.19.4
ARG PNPM_VERSION=9.15.9
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive \
    GOPATH=/tmp/sub2api-home/go \
    GOCACHE=/tmp/sub2api-home/go/cache \
    GOMODCACHE=/tmp/sub2api-home/go/pkg/mod \
    PNPM_HOME=/tmp/sub2api-home/pnpm \
    PLAYWRIGHT_BROWSERS_PATH=/opt/sub2api-playwright \
    HOME=/tmp/sub2api-home \
    PATH=/usr/local/go/bin:/usr/local/node/bin:/usr/local/bin:/tmp/sub2api-home/pnpm:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates

RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        curl \
        gcc \
        git \
        make \
        libc6-dev \
        python3 \
        python3-pip \
        redis-server \
        redis-tools \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    arch="${TARGETARCH:-}"; \
    if [ -z "${arch}" ]; then \
        case "$(uname -m)" in \
            x86_64) arch=amd64 ;; \
            aarch64|arm64) arch=arm64 ;; \
            *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;; \
        esac; \
    fi; \
    case "${arch}" in \
        amd64|x86_64) goarch=amd64; nodearch=x64 ;; \
        arm64|aarch64) goarch=arm64; nodearch=arm64 ;; \
        *) echo "unsupported architecture: ${arch}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${goarch}.tar.gz" \
        | tar -C /usr/local -xz; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${nodearch}.tar.xz" \
        | tar -C /usr/local -xJ; \
    ln -s "/usr/local/node-v${NODE_VERSION}-linux-${nodearch}" /usr/local/node; \
    corepack enable; \
    corepack prepare "pnpm@${PNPM_VERSION}" --activate; \
    mkdir -p /tmp/sub2api-home; \
    chmod 777 /tmp/sub2api-home; \
    printf 'sub2api-validation\n' >/etc/sub2api-validation

# Playwright and its Chromium revision must match the exact frontend pin.
# The browser is an image resource, never a host installation or mutable cache.
RUN pnpm dlx "playwright@${PLAYWRIGHT_VERSION}" install --with-deps chromium \
    && chmod -R a+rX /opt/sub2api-playwright \
    && rm -rf /var/lib/apt/lists/* /tmp/sub2api-home/.cache /tmp/sub2api-home/.local

# Keep the pinned package manager available when runtime networking is disabled.
RUN corepack prepare "pnpm@${PNPM_VERSION}" --activate

WORKDIR /workspace
CMD ["python3", "--version"]
